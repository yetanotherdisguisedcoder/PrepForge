# Postgres connection string. Get one from https://neon.tech (free tier), or
# from Vercel: dashboard → your project → Storage → Create Database → Postgres.
POSTGRES_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"